{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "codex/market-ready": false, "codex/launch-reliability": false, "codex/launch-manager": false, "codex/launch-next-checkpoint": false, "codex/launch-profile-editor": false, "codex/launch-restore-proof": false, "codex/launch-clinic-permissions": false } },
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/dispatch-recordatorios",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/dispatch-email",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/google-watch-renew",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/analytics/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/reconcile-suscripciones",
      "schedule": "*/15 * * * *"
    }
  ]
}
